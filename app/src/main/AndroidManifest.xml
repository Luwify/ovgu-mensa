<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.NFC" />
    <!-- Favorites notifications (asked for when the first favorite is set; everything else works without). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Installing a verified update through PackageInstaller; the user confirms each install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The card reader is optional: the menus work on phones without NFC. -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:name=".MensaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/launcher_label"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:supportsRtl="true"
        android:theme="@style/Theme.MensaMD">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Card popup: started by the system when an ISO-DEP tag is held to the phone. Own task, not in
          recents, gone as soon as it stops. The main activity has no NFC filter.
        -->
        <activity
            android:name=".CardPopupActivity"
            android:exported="true"
            android:theme="@style/Theme.MensaMD.Popup"
            android:taskAffinity="${applicationId}.popup"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|keyboard|keyboardHidden|density|fontScale|layoutDirection|locale">
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
        </activity>

        <!-- Result of an update install session (PackageInstaller). -->
        <receiver
            android:name=".data.update.InstallResultReceiver"
            android:exported="false" />

        <!--
          WorkManager starts on demand (MensaApp is its Configuration.Provider) instead of at every process
          start, so cold start and the card popup don't pay for it.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
